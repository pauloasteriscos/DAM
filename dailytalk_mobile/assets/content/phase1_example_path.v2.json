    {
      "id": "arrival.dialogue-01",
      "type": "dialogue",
      "origin": "official",
      "currentRevisionId": "arrival.dialogue-01.revision-01",
      "revisions": [
        {
          "id": "arrival.dialogue-01.revision-01",
          "activityId": "arrival.dialogue-01",
          "revisionNumber": 1,
          "title": {
            "pt-PT": "Apresentar-se"
          },
          "instructions": {
            "pt-PT": "Complete o diálogo de apresentação."
          },
          "visibility": "public",
          "competencies": [
            "arrival.greeting-basics"
          ],
          "execution": {
            "kind": "dialogue",
            "scenarioTitle": {
              "pt-PT": "Primeira apresentação",
              "fr-FR": "Première présentation"
            },
            "scenarioDescription": {
              "pt-PT": "Chegaste à família de acolhimento.",
              "fr-FR": "Tu arrives dans ta famille d’accueil."
            },
            "turns": [
              {
                "id": "turn-01",
                "partnerMessage": {
                  "pt-PT": "Olá! Eu sou a Camille.",
                  "fr-FR": "Salut ! Je suis Camille."
                },
                "prompt": {
                  "pt-PT": "Apresenta-te.",
                  "fr-FR": "Présente-toi."
                },
                "correctReply": {
                  "pt-PT": "Olá, eu sou o Paulo. Prazer!",
                  "fr-FR": "Salut, je m’appelle Paulo. Enchanté !"
                },
                "distractors": [
                  {
                    "pt-PT": "Onde fica a casa de banho?",
                    "fr-FR": "Où sont les toilettes ?"
                  },
                  {
                    "pt-PT": "Não quero comer.",
                    "fr-FR": "Je ne veux pas manger."
                  }
                ]
              },
              {
                "id": "turn-02",
                "partnerMessage": {
                  "pt-PT": "Bem-vindo! Tiveste uma boa viagem?",
                  "fr-FR": "Bienvenue ! Tu as fait bon voyage ?"
                },
                "prompt": {
                  "pt-PT": "Responde de forma natural.",
                  "fr-FR": "Réponds naturellement."
                },
                "correctReply": {
                  "pt-PT": "Sim, obrigado. A viagem correu bem.",
                  "fr-FR": "Oui, merci. Le voyage s’est bien passé."
                },
                "distractors": [
                  {
                    "pt-PT": "Até amanhã.",
                    "fr-FR": "À demain."
                  },
                  {
                    "pt-PT": "Tenho uma caneta azul.",
                    "fr-FR": "J’ai un stylo bleu."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "arrival.speech-01",
      "type": "speech",
      "origin": "official",
      "currentRevisionId": "arrival.speech-01.revision-01",
      "revisions": [
