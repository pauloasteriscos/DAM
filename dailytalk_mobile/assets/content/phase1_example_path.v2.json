          "id": "arrival.speech-01.revision-01",
          "activityId": "arrival.speech-01",
          "revisionNumber": 1,
          "title": {
            "pt-PT": "Dizer olá"
          },
          "instructions": {
            "pt-PT": "Repita as saudações apresentadas."
          },
          "visibility": "public",
          "competencies": [
            "arrival.pronunciation-basics"
          ],
          "execution": {
            "kind": "speech",
            "prompts": [
              {
                "id": "speech-hello",
                "text": {
                  "pt-PT": "Repete: Bonjour !",
                  "fr-FR": "Bonjour !"
                }
              },
              {
                "id": "speech-name",
                "text": {
                  "pt-PT": "Repete: Je m’appelle Paulo.",
                  "fr-FR": "Je m’appelle Paulo."
                }
              },
              {
                "id": "speech-thanks",
                "text": {
                  "pt-PT": "Repete: Merci beaucoup.",
                  "fr-FR": "Merci beaucoup."
                }
              }
            ]
          }
        }
      ]
    },
