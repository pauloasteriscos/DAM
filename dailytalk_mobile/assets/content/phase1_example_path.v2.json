          "revisionNumber": 1,
          "title": {
            "pt-PT": "Conhecer a família"
          },
          "instructions": {
            "pt-PT": "Escolha respostas adequadas no diálogo."
          },
          "visibility": "public",
          "competencies": [
            "arrival.greeting-basics"
          ],
          "execution": {
            "kind": "dialogue",
            "scenarioTitle": {
              "pt-PT": "Conhecer a família",
              "fr-FR": "Faire connaissance avec la famille"
            },
            "scenarioDescription": {
              "pt-PT": "Conversas simples durante o acolhimento.",
              "fr-FR": "Échanges simples pendant l’accueil."
            },
            "turns": [
              {
                "id": "turn-01",
                "partnerMessage": {
                  "pt-PT": "Este é o teu quarto.",
                  "fr-FR": "Voici ta chambre."
                },
                "prompt": {
                  "pt-PT": "Agradece.",
                  "fr-FR": "Remercie."
                },
                "correctReply": {
                  "pt-PT": "Obrigado! O quarto é muito agradável.",
                  "fr-FR": "Merci ! La chambre est très agréable."
                },
                "distractors": [
                  {
                    "pt-PT": "Não sei o meu nome.",
                    "fr-FR": "Je ne connais pas mon nom."
                  },
                  {
                    "pt-PT": "Quero ir para a escola agora.",
                    "fr-FR": "Je veux aller à l’école maintenant."
                  }
                ]
              },
              {
                "id": "turn-02",
                "partnerMessage": {
                  "pt-PT": "Precisas de alguma coisa?",
                  "fr-FR": "Tu as besoin de quelque chose ?"
                },
                "prompt": {
                  "pt-PT": "Pede ajuda educadamente.",
                  "fr-FR": "Demande de l’aide poliment."
                },
                "correctReply": {
                  "pt-PT": "Sim, por favor. Onde fica a casa de banho?",
                  "fr-FR": "Oui, s’il vous plaît. Où est la salle de bain ?"
                },
                "distractors": [
                  {
                    "pt-PT": "Tenho quinze anos.",
                    "fr-FR": "J’ai quinze ans."
                  },
                  {
                    "pt-PT": "Bom apetite.",
                    "fr-FR": "Bon appétit."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
