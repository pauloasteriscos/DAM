{
    "name":  "cloudflare-workers-openapi",
    "version":  "0.0.1",
    "private":  true,
    "scripts":  {
                    "deploy":  "wrangler deploy --config wrangler.production.jsonc",
                    "dev":  "wrangler dev --config wrangler.jsonc",
                    "start":  "wrangler dev --config wrangler.jsonc",
                    "cf-typegen":  "wrangler types --config wrangler.jsonc",
                    "typecheck":  "tsc --noEmit",
                    "keys:generate":  "node scripts/generate-sync-keys.mjs",
                    "cf-typegen:production":  "wrangler types --config wrangler.production.jsonc",
                    "test:api":  "node --test --test-concurrency=1 test/api.integration.test.mjs",
                    "test":  "npm run test:api",
                    "test:security":  "node --test --test-concurrency=1 test/security.integration.test.mjs",
                    "test:phase0":  "npm run typecheck \u0026\u0026 npm run test:api \u0026\u0026 npm run test:security"
                },
    "dependencies":  {
                         "chanfana":  "^3.3.0",
                         "fast-xml-parser":  "^5.8.0",
                         "hono":  "^4.13.5",
                         "zod":  "^4.3.6"
                     },
    "devDependencies":  {
                            "@types/node":  "^25.9.1",
                            "typescript":  "^5.9.3",
                            "wrangler":  "^4.127.1"
                        }
}
