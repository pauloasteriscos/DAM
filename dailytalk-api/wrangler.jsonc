{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dailytalk-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "ip": "localhost",
    "port": 8787,
    "local_protocol": "http"
  },
  "vars": {
    "JWT_EXPIRES_SECONDS": "7200",
    "CORS_ORIGIN": "https://dailytalk.pt,https://www.dailytalk.pt,http://localhost:5555,http://127.0.0.1:5555",
    "PASSWORD_RESET_FROM_EMAIL": "no-reply@dailytalk.pt",
    "PASSWORD_RESET_FROM_NAME": "DailyTalk.pt",
    "PASSWORD_RESET_DEBUG": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dailytalk-db",
      "database_id": "8ae71c83-12cc-4701-857e-6f719e6f806b"
    }
  ],
  "routes": [
    {
      "pattern": "dailytalk.pt/api/*",
      "zone_name": "dailytalk.pt"
    }
  ]
}