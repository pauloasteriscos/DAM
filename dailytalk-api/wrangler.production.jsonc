{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dailytalk-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_ENV": "PRD",
    "JWT_EXPIRES_SECONDS": "900",
    "DEVICE_SESSION_EXPIRES_DAYS": "730",
    "DPOP_MAX_AGE_SECONDS": "300",
    "AUTO_CREATE_SECURITY_SCHEMA": "false",
    "ALLOW_LEGACY_DEVICE_ENROLLMENT": "true",
    "SYNC_MAX_BATCH_SIZE": "50",
    "SYNC_SERVER_SIGNING_KEY_ID": "sync-sign-v1",
    "SYNC_SERVER_AGREEMENT_KEY_ID": "sync-enc-v1",
    "CORS_ORIGIN": "https://dailytalk.pt,https://www.dailytalk.pt",
    "PASSWORD_RESET_FROM_EMAIL": "no-reply@dailytalk.pt",
    "PASSWORD_RESET_FROM_NAME": "DailyTalk.pt",
    "PASSWORD_RESET_DEBUG": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dailytalk-db",
      "database_id": "8ae71c83-12cc-4701-857e-6f719e6f806b",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations"
    }
  ],
  "routes": [
    {
      "pattern": "dailytalk.pt/api/*",
      "zone_name": "dailytalk.pt"
    }
  ]
}
